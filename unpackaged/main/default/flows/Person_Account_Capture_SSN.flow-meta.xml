        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>SSN_Already_On_Record</name>
        <label>SSN Already On Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Enter_SSN</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No SSN Yet</defaultConnectorLabel>
        <rules>
            <name>Already_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ssnAlreadyPopulated</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SSN_Already_Filled_On_Record</targetReference>
            </connector>
            <label>Already Populated</label>
        </rules>
    </decisions>
    <decisions>
        <name>SSN_Values_Match</name>
        <label>SSN Values Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SSN_Mismatch</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Mismatch</defaultConnectorLabel>
        <rules>
            <name>Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inpSSN</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ssnConfirm</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Person_Account_Commit_SSN</targetReference>
            </connector>
            <label>Match</label>
        </rules>
    </decisions>
