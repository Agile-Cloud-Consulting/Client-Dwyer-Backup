    <actionCalls>
        <description>Splits the raw semicolon-delimited SelectedPrograms MultiSelectCheckboxes value into a real text collection. Flow&#39;s In filter operator does not auto-split a delimited string - confirmed via Apex replication that a trailing delimiter (e.g. &quot;test;&quot;) never matches Program.Name unless split first.</description>
        <name>Split_Selected_Programs</name>
        <label>Split Selected Programs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>SplitStringInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Get_Selected_Programs</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error_Split_Selected_Programs</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>inputString</name>
            <value>
                <elementReference>SelectedPrograms</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>delimiter</name>
            <value>
                <stringValue>;</stringValue>
            </value>
        </inputParameters>
        <nameSegment>SplitStringInvocable</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
