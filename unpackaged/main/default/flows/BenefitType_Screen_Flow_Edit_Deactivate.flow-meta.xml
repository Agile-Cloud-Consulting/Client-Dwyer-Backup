    <decisions>
        <description>Short-circuits when the global master kill switch or this flow&#39;s own named-automation kill switch is active.</description>
        <name>Is_Kill_Switch_Active</name>
        <label>Is Kill Switch Active?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Kill_Switch_Message_Screen</targetReference>
