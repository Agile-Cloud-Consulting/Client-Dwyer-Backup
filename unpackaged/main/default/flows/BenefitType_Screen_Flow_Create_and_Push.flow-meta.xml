    <recordCreates>
        <description>Creates the new Service Type (BenefitType). ProcessType is fixed to ProgramManagement.</description>
        <name>Create_Service_Type</name>
        <label>Create Service Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Split_Selected_Programs</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error_Create_Service_Type</targetReference>
