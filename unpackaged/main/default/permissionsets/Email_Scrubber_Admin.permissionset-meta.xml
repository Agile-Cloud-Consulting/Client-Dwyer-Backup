<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Access to the Email Scrubber tool. Assign to admins who need to configure and run sandbox email scrubbing.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Email Scrubber Admin</label>
    <classAccesses>
        <apexClass>EmailScrubberBatch</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>EmailScrubberController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Run_Email_Scrubber</name>
    </customPermissions>
    <tabSettings>
        <tab>Email_Scrubbing</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
