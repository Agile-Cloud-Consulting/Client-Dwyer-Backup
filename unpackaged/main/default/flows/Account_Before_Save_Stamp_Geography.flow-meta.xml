<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Stamp_Geography</name>
        <label>Stamp Geography</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Service_Area__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Zip.Service_Area__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Region__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Zip.Service_Area__r.State__r.Region__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Matching_Zip_Found</name>
        <label>Matching Zip Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Zip_Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Zip</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Geography</targetReference>
            </connector>
            <label>Zip Match</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>frmZip</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.PersonMailingPostalCode}, {!$Record.BillingPostalCode})</expression>
    </formulas>
    <interviewLabel>Account - Before Save - Stamp Geography {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Before Save - Stamp Geography</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Zip</name>
        <label>Get Zip</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Matching_Zip_Found</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmZip</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Service_Area_Zip_Code__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Zip</targetReference>
        </connector>
        <filterFormula>AND(
  NOT({!$Record.Manual_Geography_Override__c}),
  OR(
    ISNEW(),
    ISCHANGED({!$Record.BillingPostalCode}),
    ISCHANGED({!$Record.PersonMailingPostalCode}),
    ISCHANGED({!$Record.Manual_Geography_Override__c})
  )
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
