                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Child_Accounts</targetReference>
            </connector>
            <label>All Kill Switches Clear</label>
        </rules>
    </decisions>
    <description>DWDECI-43. When a parent Account&#39;s MOU_Level__c changes to Corporate Level, cascades that value to every child Account (by ParentId). Single bulk Update Records (no DML in loops). Checks the Global, Object (Account), and Automation kill switches from ACC Base Utilities. Fault path -&gt; ErrorLogger.logFromFlow (ACC Base Utilities Log Error action).</description>
    <environments>Default</environments>
    <interviewLabel>Account - On Edit - Cascade MOU Level {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - On Edit - Cascade MOU Level</label>
    <loops>
        <description>Iterates every child Account of the record whose MOU_Level__c just changed to Corporate Level.</description>
        <name>Loop_Child_Accounts</name>
        <label>Loop Child Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Child_Accounts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Child_MOU_Level</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Child_Accounts</targetReference>
        </noMoreValuesConnector>
    </loops>
