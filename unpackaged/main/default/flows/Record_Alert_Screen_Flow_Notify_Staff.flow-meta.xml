    <assignments>
        <description>Composes the email subject and body from the Business Incident&#39;s Category, Subject, and Description. Uses Category_Label__c (Red/Yellow/Green) rather than the raw Severity field, since Severity is intentionally left unpopulated/hidden per the DWDECI-40 decision - Category is the classification that is actually used and populated.</description>
        <name>Build_Email_Content</name>
        <label>Build Email Content</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>emailSubject</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Business Incident Alert: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailSubject</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Record_Alert.Subject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailBody</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Category: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailBody</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Record_Alert.Category_Label__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailBody</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>

Subject: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailBody</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Record_Alert.Subject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailBody</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>

Description: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailBody</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Record_Alert.Description</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Notification</targetReference>
        </connector>
    </assignments>
    <description>Record Alert (Business Incident) quick action &quot;Notify Staff&quot; (DWDECI-41). Lets the user who logged a severe Partner incident pick recipient Users at runtime and confirm the incident summary, then sends the notification via the shared &quot;Shared - Autolaunched - Send Team Notification&quot; subflow (also used by DWDECI-39). Works for incidents against any Parent (facility Business Account or otherwise) since it only reads Subject/Description/Category, not the polymorphic Parent itself. Fault paths on this flow&#39;s own lookups -&gt; ErrorLogger.logFromFlow (ACC Base Utilities Log Error action); the Subflow element itself can&#39;t carry a fault connector in Metadata API, so send failures are logged inside the shared subflow.</description>
    <dynamicChoiceSets>
        <name>Recipient_Choices</name>
        <collectionReference>Get_Active_Users</collectionReference>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>User</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>Record_Alert_URL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND(&#39;/services&#39;, {!$Api.Partner_Server_URL_260})) &amp; {!recordId}</expression>
    </formulas>
    <interviewLabel>Record Alert - Screen Flow - Notify Staff {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record Alert - Screen Flow - Notify Staff</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Gets active Users as the recipient choice source.</description>
        <name>Get_Active_Users</name>
        <label>Get Active Users</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Notify_Staff_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error_Get_Active_Users</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the Record Alert (Business Incident) and its Subject/Description/Category for the summary display and email content.</description>
        <name>Get_Record_Alert</name>
        <label>Get Record Alert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Active_Users</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error_Get_Record_Alert</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordAlert</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>Category_Label__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <description>Confirms the notification was sent.</description>
        <name>Confirmation_Screen</name>
        <label>Confirmation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Confirmation_Text</name>
            <fieldText>&lt;p&gt;Staff notified.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Recipient selection and incident summary confirmation.</description>
        <name>Notify_Staff_Screen</name>
        <label>Notify Staff</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Build_Email_Content</targetReference>
        </connector>
        <fields>
            <name>Incident_Summary</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Category:&lt;/strong&gt; {!Get_Record_Alert.Category_Label__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Subject:&lt;/strong&gt; {!Get_Record_Alert.Subject}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Description:&lt;/strong&gt; {!Get_Record_Alert.Description}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Recipients_Field</name>
            <choiceReferences>Recipient_Choices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Select Recipients</fieldText>
            <fieldType>MultiSelectCheckboxes</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Record_Alert</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <description>Sends the composed email via the shared, content-agnostic notification subflow (also used by DWDECI-39).</description>
        <name>Send_Notification</name>
        <label>Send Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Confirmation_Screen</targetReference>
        </connector>
        <flowName>Shared_Autolaunched_Send_Team_Notification</flowName>
        <inputAssignments>
            <name>recipientUserIds</name>
            <value>
