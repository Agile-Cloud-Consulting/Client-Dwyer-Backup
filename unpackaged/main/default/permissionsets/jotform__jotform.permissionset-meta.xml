<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants rights needed for Jotform App user.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Jotform App User</label>
    <classAccesses>
        <apexClass>jotform__JotformSetupController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <applicationVisibilities>
        <application>jotform__Jotform</application>
        <visible>true</visible>
    </applicationVisibilities>
    <fieldPermissions>
        <editable>true</editable>
        <field>jotform__JotformUser__c.jotform__AccountType__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>jotform__JotformUser__c.jotform__ApiUrl__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>jotform__JotformUser__c.jotform__Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>jotform__JotformUser__c.jotform__Url__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>jotform__JotformUser__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <tabSettings>
        <tab>jotform__GettingStarted</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>jotform__MyForms</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>jotform__Resources</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
