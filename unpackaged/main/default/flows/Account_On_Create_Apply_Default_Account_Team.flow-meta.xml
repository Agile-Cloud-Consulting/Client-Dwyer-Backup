    <decisions>
        <description>Short-circuits when any ACC Base Utilities kill switch covering this automation is active: the global master switch, the Account object switch, or this flow&#39;s own named-automation switch.</description>
        <name>Is_Kill_Switch_Active</name>
        <label>Is Kill Switch Active?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Kill Switch Active</defaultConnectorLabel>
        <rules>
            <name>All_Kill_Switches_Clear</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.Global_Kill_Switch__c.Disable_All__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Object_Kill_Switch__c.Disable_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Automation_Kill_Switch__c.Disable_Apply_Default_Account_Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Team_Defaults</targetReference>
            </connector>
            <label>All Kill Switches Clear</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only builds a team member for CMDT rows whose Member_Username__c resolved to an active User.</description>
        <name>Is_Member_User_Found</name>
        <label>Is Member User Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Log_Warning_Member_User_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Member User Not Found</defaultConnectorLabel>
        <rules>
            <name>Member_User_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Member_User.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Account_Team_Member</targetReference>
            </connector>
            <label>Member User Found</label>
        </rules>
    </decisions>
    <description>DWDECI-32. On new Partner Account creation (Partner_Type__c populated), applies the org-wide default Account Team from Account_Team_Default__mdt rows matching the Account&#39;s Region. Guarded by Global/Object(Account)/Automation kill switches (ACC Base Utilities pattern). Users are resolved by Username at runtime - no hardcoded Ids. Team members are committed with a single bulk Create Records (no DML in loops). The original Account owner keeps native ownership/visibility regardless of team membership. Fault paths -&gt; ErrorLogger.logFromFlow (ACC Base Utilities Log Error action).</description>
    <environments>Default</environments>
    <interviewLabel>Account - On Create - Apply Default Account Team {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - On Create - Apply Default Account Team</label>
    <loops>
        <description>Iterates the active Account_Team_Default__mdt rows matched to this Account&#39;s Region.</description>
        <name>Loop_Account_Team_Defaults</name>
        <label>Loop Account Team Defaults</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Account_Team_Defaults</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Member_User</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Account_Team_Members</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Single bulk create of every resolved Account Team Member (no DML in the loop). A no-op if the collection ended up empty (unmapped region, or no usernames resolved).</description>
        <name>Create_Account_Team_Members</name>
        <label>Create Account Team Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Error_Create_Account_Team_Members</targetReference>
        </faultConnector>
        <inputReference>colAccountTeamMembersToCreate</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Gets the active org-wide default team rows for this Account&#39;s Region. No hardcoded record Ids - matched purely by Region name.</description>
        <name>Get_Account_Team_Defaults</name>
        <label>Get Account Team Defaults</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Account_Team_Defaults</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error_Get_Account_Team_Defaults</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Region_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Region__r.Name</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account_Team_Default__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Team_Role__c</queriedFields>
        <queriedFields>Member_Username__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Resolves the CMDT row&#39;s Member_Username__c to an active User Id at runtime - no hardcoded Ids.</description>
        <name>Get_Member_User</name>
        <label>Get Member User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Member_User_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error_Get_Member_User</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Username</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Account_Team_Defaults.Member_Username__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Kill_Switch_Active</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Partner_Type__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
