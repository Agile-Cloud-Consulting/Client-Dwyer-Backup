    <description>Interaction quick action &quot;Notify Team&quot;. Lets the user who logged a bi-weekly partner meeting pick recipient Users at runtime and confirm the meeting-note summary, then sends the notification via the shared &quot;Shared - Autolaunched - Send Team Notification&quot; subflow (also used by DWDECI-41). Fault paths on this flow&#39;s own lookups -&gt; ErrorLogger.logFromFlow (ACC Base Utilities Log Error action); the Subflow element itself can&#39;t carry a fault connector in Metadata API, so send failures are logged inside the shared subflow.</description>
    <dynamicChoiceSets>
        <name>Recipient_Choices</name>
        <collectionReference>Get_Active_Users</collectionReference>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>User</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>Interaction_Record_URL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND(&#39;/services&#39;, {!$Api.Partner_Server_URL_260})) &amp; {!recordId}</expression>
    </formulas>
    <interviewLabel>Interaction - Screen Flow - Notify Team {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Interaction - Screen Flow - Notify Team</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Gets active Users as the recipient choice source.</description>
        <name>Get_Active_Users</name>
        <label>Get Active Users</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Notify_Team_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error_Get_Active_Users</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the Interaction and its structured meeting-note fields for the summary display and email content.</description>
        <name>Get_Interaction</name>
        <label>Get Interaction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Active_Users</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error_Get_Interaction</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Interaction</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Schedule_Status_Notes__c</queriedFields>
        <queriedFields>New_Class_Requests_Notes__c</queriedFields>
        <queriedFields>Scholar_Paperwork_Check_In_Notes__c</queriedFields>
        <queriedFields>Class_Retention_Attrition_Notes__c</queriedFields>
        <queriedFields>Licensing_Percentage_Notes__c</queriedFields>
        <queriedFields>Scholar_Employment_Notes__c</queriedFields>
        <queriedFields>Agenda__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <description>Confirms the notification was sent.</description>
        <name>Confirmation_Screen</name>
        <label>Confirmation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Confirmation_Text</name>
            <fieldText>&lt;p&gt;Team notified.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Recipient selection and meeting-note summary confirmation.</description>
        <name>Notify_Team_Screen</name>
        <label>Notify Team</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Build_Email_Content</targetReference>
        </connector>
        <fields>
            <name>Meeting_Notes_Summary</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Schedule Status:&lt;/strong&gt; {!Get_Interaction.Schedule_Status_Notes__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;New Class Requests:&lt;/strong&gt; {!Get_Interaction.New_Class_Requests_Notes__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Scholar Paperwork Check-In:&lt;/strong&gt; {!Get_Interaction.Scholar_Paperwork_Check_In_Notes__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Class Retention &amp;amp; Attrition:&lt;/strong&gt; {!Get_Interaction.Class_Retention_Attrition_Notes__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Licensing Percentage:&lt;/strong&gt; {!Get_Interaction.Licensing_Percentage_Notes__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Scholar Employment:&lt;/strong&gt; {!Get_Interaction.Scholar_Employment_Notes__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Agenda:&lt;/strong&gt; {!Get_Interaction.Agenda__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Recipients_Field</name>
            <choiceReferences>Recipient_Choices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Select Recipients</fieldText>
            <fieldType>MultiSelectCheckboxes</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Interaction</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <description>Sends the composed email via the shared, content-agnostic notification subflow (also used by DWDECI-41).</description>
        <name>Send_Notification</name>
        <label>Send Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Confirmation_Screen</targetReference>
        </connector>
        <flowName>Shared_Autolaunched_Send_Team_Notification</flowName>
        <inputAssignments>
            <name>recipientUserIds</name>
            <value>
                <elementReference>Recipients_Field</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>emailSubject</name>
            <value>
                <elementReference>emailSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>emailBody</name>
            <value>
                <elementReference>emailBody</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordLink</name>
            <value>
                <elementReference>Interaction_Record_URL</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>emailBody</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>emailSubject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
