            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UnitofMeasureId</field>
            <value>
                <elementReference>UnitOfMeasure</elementReference>
            </value>
        </inputAssignments>
        <object>BenefitType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Gets the full Program records (Id and Name) for whatever was selected on screen, to build each child Benefit&#39;s name and lookup.</description>
        <name>Get_Selected_Programs</name>
        <label>Get Selected Programs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Selected_Programs</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error_Get_Selected_Programs</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>Split_Selected_Programs.values</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Program</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
