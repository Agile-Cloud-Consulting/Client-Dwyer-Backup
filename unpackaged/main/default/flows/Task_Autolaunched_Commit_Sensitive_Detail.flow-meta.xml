            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputParameters>
        <nameSegment>ErrorLogger</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>System-context subflow for the &quot;Log Sensitive Detail&quot; Task quick action. Writes Sensitive__c and Sensitive_Details__c on the given Task without enforcing the running user&#39;s FLS/sharing, so a user without DWD_Sensitive_Activity_Details can log a sensitive narrative but never gains read access to it afterward (same pattern as the DWDECI-19 SSN capture subflow). Fault path -&gt; ErrorLogger.logFromFlow (ACC Base Utilities Log Error action).</description>
    <environments>Default</environments>
    <interviewLabel>Task - Autolaunched - Commit Sensitive Detail {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task - Autolaunched - Commit Sensitive Detail</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Sets Sensitive__c and writes the narrative into Sensitive_Details__c. Runs in system context so it succeeds even when the invoking user has no FLS on Sensitive_Details__c.</description>
        <name>Update_Sensitive_Task</name>
        <label>Update Sensitive Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Error_Update_Sensitive_Task</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Sensitive_Details__c</field>
            <value>
                <elementReference>sensitiveDetails</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sensitive__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Sensitive_Task</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
