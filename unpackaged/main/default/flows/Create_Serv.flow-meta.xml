<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Benefits</name>
        <label>Assign Benefits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Benefitstocreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>SingleBenefit</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ServiceListHtml</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ServiceListItemFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ServiceCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>For_each_selected_program</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Benefit_Assignment</name>
        <label>Benefit Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SingleBenefit.ProgramId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_each_selected_program.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleBenefit.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>BenefitNameFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleBenefit.IsActive</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleBenefit.BenefitTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Benefits</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <description>Avoids showing an empty selection table when the org has no active programs.</description>
        <name>Check_Active_Programs_Found</name>
        <label>Any Active Programs?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Active_Programs_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Active Programs</defaultConnectorLabel>
        <rules>
            <name>Active_Programs_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Programs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Active_Program_List</targetReference>
            </connector>
            <label>Active Programs Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Stops the flow reaching Create Records with an empty collection, which would throw an unhandled error.</description>
        <name>Check_Services_To_Create</name>
        <label>Any Services To Create?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Programs_Selected_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Programs Selected</defaultConnectorLabel>
        <rules>
            <name>Has_Services_To_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ServiceCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Benefit_Records</targetReference>
            </connector>
            <label>Has Services To Create</label>
        </rules>
    </decisions>
    <description>Create Services For Selected Programs</description>
    <environments>Default</environments>
    <formulas>
        <name>BenefitNameFormula</name>
        <dataType>String</dataType>
        <expression>{!Get_Benefit_Type.Name}&amp; &quot; - &quot; &amp; {!For_each_selected_program.Name}</expression>
    </formulas>
    <formulas>
        <description>One bullet line per created service. Evaluated inside the loop, so it uses the current program.</description>
        <name>ServiceListItemFormula</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;li&gt;&quot; &amp; {!Get_Benefit_Type.Name} &amp; &quot; - &quot; &amp; {!For_each_selected_program.Name} &amp; &quot;&lt;/li&gt;&quot;</expression>
    </formulas>
    <formulas>
        <description>Matching verb for the confirmation summary.</description>
        <name>ServiceVerbFormula</name>
        <dataType>String</dataType>
        <expression>IF({!ServiceCount} = 1, &quot;was&quot;, &quot;were&quot;)</expression>
    </formulas>
    <formulas>
        <description>Singular or plural noun for the confirmation summary.</description>
        <name>ServiceWordFormula</name>
        <dataType>String</dataType>
        <expression>IF({!ServiceCount} = 1, &quot;service&quot;, &quot;services&quot;)</expression>
    </formulas>
    <interviewLabel>Create Serv {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Services For Selected Programs</label>
    <loops>
        <name>For_each_selected_program</name>
        <label>For each selected program</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>ProgramSelectionList.selectedRows</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Benefit_Assignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Services_To_Create</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Benefit_Records</name>
        <label>Create Benefit Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Confirmation_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <inputReference>Benefitstocreate</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Get Active Programs</description>
        <name>Get_Active_Programs</name>
        <label>Get Active Programs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Active_Programs_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Program</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Benefit_Type</name>
        <label>Get Benefit Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Active_Programs</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>BenefitType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <description>Summarises what was created. Back and Pause are off so the records cannot be created twice.</description>
        <name>Confirmation_Screen</name>
        <label>Services Created</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Confirmation_Heading</name>
            <fieldText>&lt;p&gt;&lt;b&gt;All done.&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Confirmation_Summary</name>
            <fieldText>&lt;p&gt;{!ServiceCount} {!ServiceWordFormula} {!ServiceVerbFormula} created for benefit type &lt;b&gt;{!Get_Benefit_Type.Name}&lt;/b&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Confirmation_Service_List</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Services created&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;{!ServiceListHtml}&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Confirmation_Next_Steps</name>
            <fieldText>&lt;p&gt;Each one is active and linked to its program. You can find them on the &lt;b&gt;Benefits&lt;/b&gt; related list of this benefit type record.&lt;/p&gt;&lt;p&gt;Select &lt;b&gt;Finish&lt;/b&gt; to close.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Shown when a lookup or the record create fails. Reached by fault connectors.</description>
        <name>Error_Screen</name>
        <label>Something Went Wrong</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Heading</name>
            <fieldText>&lt;p&gt;&lt;b&gt;We could not create the services.&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Error_Explanation</name>
            <fieldText>&lt;p&gt;Nothing was saved, so you can safely try again. If it fails a second time, copy the details below and send them to your Salesforce administrator.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Error_Details</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Details for your administrator&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Benefit type: {!Get_Benefit_Type.Name}&lt;/p&gt;&lt;p&gt;Error: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Shown when the org has no active programs to pick from.</description>
        <name>No_Active_Programs_Screen</name>
        <label>No Active Programs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Active_Programs_Message</name>
            <fieldText>&lt;p&gt;&lt;b&gt;There are no active programs to choose from.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Services can only be created for programs that are marked active. Ask your Salesforce administrator to activate at least one program, then run this again.&lt;/p&gt;&lt;p&gt;Select &lt;b&gt;Finish&lt;/b&gt; to close.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Safety net for a submission with nothing selected. Back returns to the program list.</description>
        <name>No_Programs_Selected_Screen</name>
        <label>No Programs Selected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Programs_Selected_Message</name>
            <fieldText>&lt;p&gt;&lt;b&gt;You did not select any programs.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Nothing was created. Select &lt;b&gt;Previous&lt;/b&gt; to go back and choose at least one program, or &lt;b&gt;Finish&lt;/b&gt; to close without creating anything.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Show_Active_Program_List</name>
        <label>Select Programs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>For_each_selected_program</targetReference>
        </connector>
