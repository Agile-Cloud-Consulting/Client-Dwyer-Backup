    <assignments>
        <description>Builds one Benefit record for the current loop iteration&#39;s Program and adds it to the create collection. Reuses the same UnitOfMeasure the admin picked for the parent Service Type.</description>
        <name>Build_Benefit_Record</name>
        <label>Build Benefit Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_Benefit.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ServiceTypeName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Benefit.Name</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue> - </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Benefit.Name</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Selected_Programs.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Benefit.BenefitTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Service_Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Benefit.ProgramId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Selected_Programs.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Benefit.IsActive</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Benefit.CanRegisterAsProvider</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Benefit.UnitId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>UnitOfMeasure</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colBenefitsToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>var_Benefit</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Selected_Programs</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Short-circuits when the global master kill switch or this flow&#39;s own named-automation kill switch is active.</description>
        <name>Is_Kill_Switch_Active</name>
        <label>Is Kill Switch Active?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Kill_Switch_Message_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Kill Switch Active</defaultConnectorLabel>
        <rules>
            <name>All_Kill_Switches_Clear</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.Global_Kill_Switch__c.Disable_All__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Automation_Kill_Switch__c.Disable_Benefit_Type_Create_and_Push__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Service_Type_Screen</targetReference>
            </connector>
            <label>All Kill Switches Clear</label>
        </rules>
    </decisions>
    <description>DWDECI-119. Admin screen flow: creates a new Service Type (BenefitType) and pushes child Benefit records to every selected, currently-active Program in a single bulk Create Records call (governor-limit safe for 200+ Programs). ProcessType is fixed to ProgramManagement since this org only uses BenefitType for that purpose. SelectedPrograms (MultiSelectCheckboxes bound to ActiveProgramChoices, valueField=Id) correctly returns Program Ids, but as a semicolon-delimited raw string (e.g. &quot;11WWE000005e4Mz2AI;&quot;), and Flow&#39;s In filter operator does not auto-split a delimited string - confirmed via Apex/debug log that the undivided string never matches. Split_Selected_Programs (SplitStringInvocable Apex action) splits it into a real text collection of Ids before the Get_Selected_Programs lookup (filters on Id IN Split_Selected_Programs.values). Fault paths -&gt; ErrorLogger.logFromFlow (ACC Base Utilities Log Error action).</description>
    <dynamicChoiceSets>
        <name>ActiveProgramChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Program</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>UnitOfMeasureChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>UnitOfMeasure</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
